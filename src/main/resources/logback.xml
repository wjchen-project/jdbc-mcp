<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 日志目录：默认为 JAR 同级目录下的 logs/，可通过 app.home 系统属性覆盖 -->
    <property name="LOG_HOME" value="${app.home:-.}/logs"/>

    <!-- 控制台输出（仅输出到 stderr，严禁输出到 stdout） -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 滚动文件输出：每日滚动 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/jdbc-mcp.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- 每日滚动，归档文件名含日期 -->
            <fileNamePattern>${LOG_HOME}/jdbc-mcp.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- 保留最近 30 天的日志 -->
            <maxHistory>30</maxHistory>
            <!-- 所有归档日志总大小上限 1GB -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 应用日志：INFO 及以上输出到 stderr + 文件 -->
    <logger name="com.jdbcmcp" level="INFO"/>

    <!-- 第三方库日志：仅 WARN 及以上 -->
    <logger name="io.modelcontextprotocol" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
